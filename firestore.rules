rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  LINKify — Firestore Security Rules (FIXED v3)                              ║
// ║                                                                             ║
// ║  ROOT CAUSE FIXES:                                                          ║
// ║  [FIX-01] Dot-notation fields ('premium.templateTheme') di Firestore        ║
// ║           rules: affectedKeys() mengembalikan 'premium.templateTheme'       ║
// ║           bukan 'premium' — sehingga hasOnly(['premium']) SELALU GAGAL.     ║
// ║           FIX: Pisahkan rule update menjadi per-operasi (settings, premium, ║
// ║           gallery, customButtons) dengan affectedKeys yang tepat.           ║
// ║                                                                             ║
// ║  [FIX-02] validOwnerTokoValues() validasi 'in' map tidak bisa dipakai      ║
// ║           untuk dot-notation keys — hapus validasi map nested premium,      ║
// ║           ganti dengan validasi per-field langsung.                         ║
// ║                                                                             ║
// ║  [FIX-03] Rule create /toko/{uid} hanya allow isAdmin() → setDoc dari      ║
// ║           admin-daftar.js pakai auth instance admin yang login ke panel.    ║
// ║           Ini benar, tapi HARUS pastikan token tidak expired dan isAdmin()  ║
// ║           resolve ke true. Ditambah validasi field yang lebih tepat.        ║
// ║                                                                             ║
// ║  [FIX-04] Rule update owner: validOwnerTokoFields() pakai affectedKeys()   ║
// ║           yang tidak compatible dengan dot-notation. Ganti ke per-operasi. ║
// ║                                                                             ║
// ║  [FIX-05] settings save (admin.js) mengirim 'updatedAt' tapi              ║
// ║           validOwnerTokoFields() tidak mengizinkan 'updatedAt'.            ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ══════════════════════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // isAdmin() — dual check:
    //   1. Custom claim (preferred, set via Firebase Admin SDK)
    //   2. Email fallback (verified email, backwards-compat)
    function isAdmin() {
      return isAuth() && (
        request.auth.token.admin == true
        ||
        (request.auth.token.email == 'unrageunrage@gmail.com'
         && request.auth.token.email_verified == true)
      );
    }

    // ── Primitive validators ──────────────────────────────────────────────────

    function validStr(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function validStrOrEmpty(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Hanya allow https:// URL atau string kosong.
    function validUrl(val) {
      return val is string
          && val.size() <= 2048
          && (val == '' || val.matches('https://.*'));
    }

    // WhatsApp URL — lebih ketat
    function validWaUrl(val) {
      return val is string
          && val.size() <= 512
          && (val == '' || val.matches('https://(wa\\.me|api\\.whatsapp\\.com)/.*'));
    }

    // Hex color: #RRGGBB
    function validHexColor(val) {
      return val is string && val.matches('#[0-9a-fA-F]{6}');
    }

    // Date string YYYY-MM-DD
    function validDateId(id) {
      return id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // ── customButtons per-item validator ─────────────────────────────────────
    function validCustomButton(b) {
      return b is map
          && ('label' in b) && validStr(b.label, 60)
          && ('url'   in b) && validUrl(b.url)
          && (!('color' in b) || validHexColor(b.color))
          && (!('desc'  in b) || validStrOrEmpty(b.desc, 120))
          && b.keys().hasOnly(['label', 'url', 'color', 'desc']);
    }

    function validCustomButtonList(list) {
      return list.size() == 0
          || (
               (list.size() < 1  || validCustomButton(list[0]))
            && (list.size() < 2  || validCustomButton(list[1]))
            && (list.size() < 3  || validCustomButton(list[2]))
            && (list.size() < 4  || validCustomButton(list[3]))
            && (list.size() < 5  || validCustomButton(list[4]))
            && (list.size() < 6  || validCustomButton(list[5]))
            && (list.size() < 7  || validCustomButton(list[6]))
            && (list.size() < 8  || validCustomButton(list[7]))
            && (list.size() < 9  || validCustomButton(list[8]))
            && (list.size() < 10 || validCustomButton(list[9]))
          );
    }

    // ── gallery per-item validator ────────────────────────────────────────────
    function validGalleryItem(g) {
      return g is map
          && ('url' in g) && validUrl(g.url) && g.url != ''
          && (!('caption'  in g) || validStrOrEmpty(g.caption, 200))
          && (!('kategori' in g) || validStrOrEmpty(g.kategori, 60))
          && g.keys().hasOnly(['url', 'caption', 'kategori']);
    }

    function validGalleryList(list) {
      return list.size() == 0
          || (
               (list.size() < 1  || validGalleryItem(list[0]))
            && (list.size() < 2  || validGalleryItem(list[1]))
            && (list.size() < 3  || validGalleryItem(list[2]))
            && (list.size() < 4  || validGalleryItem(list[3]))
            && (list.size() < 5  || validGalleryItem(list[4]))
            && (list.size() < 6  || validGalleryItem(list[5]))
            && (list.size() < 7  || validGalleryItem(list[6]))
            && (list.size() < 8  || validGalleryItem(list[7]))
            && (list.size() < 9  || validGalleryItem(list[8]))
            && (list.size() < 10 || validGalleryItem(list[9]))
            && (list.size() < 11 || validGalleryItem(list[10]))
            && (list.size() < 12 || validGalleryItem(list[11]))
          );
    }

    // ── Product field validator ───────────────────────────────────────────────
    function validProduk(d) {
      return validStr(d.nama, 100)
          && d.harga is number && d.harga >= 0 && d.harga <= 999999999
          && d.stok  is number && d.stok  >= 0 && d.stok  <= 999999
          && (!('deskripsi' in d) || validStrOrEmpty(d.deskripsi, 500))
          && (!('shopee'    in d) || validUrl(d.shopee))
          && (!('wa'        in d) || validWaUrl(d.wa))
          && (!('img'       in d) || validUrl(d.img))
          && (!('kategori'  in d) || validStrOrEmpty(d.kategori, 50))
          && (!('hargaAsli' in d) || (d.hargaAsli is number && d.hargaAsli >= 0))
          && (!('berat'     in d) || (d.berat is number && d.berat >= 0))
          && (!('unggulan'  in d) || d.unggulan is bool)
          && (!('stokAwal'  in d) || (d.stokAwal is number && d.stokAwal >= 0));
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /toko/{uid}
    // ══════════════════════════════════════════════════════════════════════════
    match /toko/{uid} {

      // Storefront publik dapat dibaca siapa saja
      allow read: if true;

      // ── CREATE: hanya admin (via panel admin-daftar) ──────────────────────
      // [FIX-03] Validasi field create lebih permissive — admin yang bertanggung jawab
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'namaToko','pemilik','email','wa','shopee','tokopedia',
             'instagram','tiktok','twitter','facebook','youtube',
             'logo','bio','plan','status','omset','gallery',
             'customButtons','premium','dibuatPada','updatedAt'
           ])
        && validStr(request.resource.data.namaToko, 100)
        && validStr(request.resource.data.pemilik, 80)
        && request.resource.data.plan in ['free','basic','premium']
        && request.resource.data.status in ['aktif','blokir'];

      // ── DELETE: hanya admin ───────────────────────────────────────────────
      allow delete: if isAdmin();

      // ── UPDATE ────────────────────────────────────────────────────────────
      // Admin bisa update apapun (plan, status, premium fields, dll)
      allow update: if isAdmin();

      // Owner update pengaturan toko (Pengaturan tab):
      // Keys: namaToko, bio, wa, shopee, tokopedia, instagram, tiktok,
      //       twitter, facebook, youtube, logo, updatedAt
      // [FIX-01] [FIX-04] [FIX-05]: affectedKeys yang benar, termasuk updatedAt
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['namaToko','bio','wa','shopee','tokopedia',
                       'instagram','tiktok','twitter','facebook','youtube',
                       'logo','updatedAt'])
        && (!('namaToko'  in request.resource.data.diff(resource.data).affectedKeys())
             || validStr(request.resource.data.namaToko, 100))
        && (!('bio'       in request.resource.data.diff(resource.data).affectedKeys())
             || validStrOrEmpty(request.resource.data.bio, 200))
        && (!('wa'        in request.resource.data.diff(resource.data).affectedKeys())
             || validWaUrl(request.resource.data.wa))
        && (!('shopee'    in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.shopee))
        && (!('tokopedia' in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.tokopedia))
        && (!('instagram' in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.instagram))
        && (!('tiktok'    in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.tiktok))
        && (!('twitter'   in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.twitter))
        && (!('facebook'  in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.facebook))
        && (!('youtube'   in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.youtube))
        && (!('logo'      in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.logo));

      // Owner update customButtons (Tombol Kustom):
      // [FIX-01]: customButtons bukan dot-notation, tapi perlu rule sendiri
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['customButtons'])
        && request.resource.data.customButtons is list
        && request.resource.data.customButtons.size() <= 10
        && validCustomButtonList(request.resource.data.customButtons);

      // Owner update gallery:
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['gallery'])
        && request.resource.data.gallery is list
        && request.resource.data.gallery.size() <= 12
        && validGalleryList(request.resource.data.gallery);

      // [FIX-01] Owner update premium fields via dot-notation:
      // updateDoc({`premium.accentColor`: '#FF6B35'}) → affectedKeys = ['premium.accentColor']
      // updateDoc({`premium.templateTheme`: 'fashion'}) → affectedKeys = ['premium.templateTheme']
      // updateDoc({`premium.templateBg`: 'https://...'}) → affectedKeys = ['premium.templateBg']
      // updateDoc({`premium.templateTheme`: x, `premium.templateBg`: y}) → affectedKeys = both
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['premium.accentColor','premium.templateTheme','premium.templateBg'])
        && (!('premium.accentColor'   in request.resource.data.diff(resource.data).affectedKeys())
             || validHexColor(request.resource.data.premium.accentColor))
        && (!('premium.templateTheme' in request.resource.data.diff(resource.data).affectedKeys())
             || validStrOrEmpty(request.resource.data.premium.templateTheme, 50))
        && (!('premium.templateBg'    in request.resource.data.diff(resource.data).affectedKeys())
             || validUrl(request.resource.data.premium.templateBg));

      // ════════════════════════════════════════════════════════════════════════
      // /toko/{uid}/produk/{produkId}
      // ════════════════════════════════════════════════════════════════════════
      match /produk/{produkId} {

        allow read: if true;

        allow create: if isOwner(uid)
          && validProduk(request.resource.data)
          && request.resource.data.keys().hasOnly([
               'nama','harga','stok','deskripsi','shopee','wa',
               'img','kategori','createdAt','updatedAt',
               'hargaAsli','berat','unggulan','stokAwal'
             ]);

        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nama','harga','stok','deskripsi','shopee','wa','img',
                         'kategori','updatedAt','hargaAsli','berat','unggulan','stokAwal'])
          && validProduk(request.resource.data);

        allow delete: if isOwner(uid) || isAdmin();
      }

      // ════════════════════════════════════════════════════════════════════════
      // /toko/{uid}/stats/{date}
      // ════════════════════════════════════════════════════════════════════════
      match /stats/{date} {

        // Hanya owner / admin yang bisa baca statistik
        allow read: if isOwner(uid) || isAdmin();

        // Pengunjung bisa create/update stats (increment counter)
        // Hardened: doc ID harus YYYY-MM-DD, hanya field counter yang diizinkan
        allow create: if
          validDateId(date)
          && request.resource.data.keys().hasOnly(['visits','waClicks','shopeeClicks'])
          && request.resource.data.keys().size() == 1
          && (
               ('visits'       in request.resource.data && request.resource.data.visits == 1)
               || ('waClicks'  in request.resource.data && request.resource.data.waClicks == 1)
               || ('shopeeClicks' in request.resource.data && request.resource.data.shopeeClicks == 1)
             );

        allow update: if
          validDateId(date)
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['visits','waClicks','shopeeClicks'])
          && (
               (!('visits' in request.resource.data.diff(resource.data).changedKeys())
                 || request.resource.data.visits == resource.data.visits + 1)
               && (!('waClicks' in request.resource.data.diff(resource.data).changedKeys())
                 || request.resource.data.waClicks == resource.data.waClicks + 1)
               && (!('shopeeClicks' in request.resource.data.diff(resource.data).changedKeys())
                 || request.resource.data.shopeeClicks == resource.data.shopeeClicks + 1)
             );

        allow delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // /config/{docId}
    // ══════════════════════════════════════════════════════════════════════════
    match /config/{docId} {
      allow read:  if true;      // diperlukan oleh maintenance.js (publik)
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // Catch-all: tolak semua yang tidak cocok
    // ══════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
